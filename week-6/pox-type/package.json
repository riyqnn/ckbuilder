{
  "name": "pox-type",
  "version": "0.1.0",
  "description": "Proof of X attestation Type Script (ckb-js-vm)",
  "private": true,
  "type": "module",
  "scripts": {
    "build:contract": "node scripts/build-contract.js",
    "build": "node scripts/build-all.js",
    "build:debug": "node scripts/build-all.js --debug",
    "deploy": "node scripts/deploy.js",
    "test": "run-s build test:only",
    "test:only": "jest",
    "clean": "rimraf dist",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@ckb-js-std/bindings": "~1.0.0",
    "@ckb-js-std/core": "~1.0.0"
  },
  "devDependencies": {
    "@ckb-ccc/core": "^1.22.0",
    "@types/jest": "~29.5.14",
    "@types/node": "~22.13.8",
    "ckb-testtool": "1.0.5",
    "esbuild": "~0.25.8",
    "jest": "~29.7.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "ts-jest": "~29.2.6",
    "typescript": "~5.8.2"
  }
}
